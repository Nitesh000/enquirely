# Copy to .env.local and fill in. Parsed by lib/env.ts at startup --- a
# missing or malformed value fails the boot loudly instead of at 3am.

# Local Postgres from docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://inquirely:inquirely@localhost:5433/inquirely"

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Omit both and the GitHub button hides itself.
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional. Without it the app runs normally and AI endpoints return a clean
# 503 instead of crashing. Needed for /api/ai/generate-form.
#
# Comma-separated, used strictly in order: the first key is drained before
# the second is touched. When one hits its daily cap it is parked until the
# limit resets and the next one takes over automatically.
#   GROQ_API_KEYS="gsk_aaa,gsk_bbb,gsk_ccc"
GROQ_API_KEYS=""

# Optional overrides. Defaults are a point in time --- check the current list
# at https://console.groq.com/docs/models. Both tiers must support tool
# calling, or structured output in the generation graph will fail.
# GROQ_MODEL_FAST="llama-3.1-8b-instant"
# GROQ_MODEL_SMART="llama-3.3-70b-versatile"

# Optional. Where key exhaustion is recorded so every instance shares one
# view. Without it rotation still works, but per-process only --- fine
# locally, wrong on a multi-instance deploy. `pnpm db:up` starts this.
REDIS_URL="redis://localhost:6379"
